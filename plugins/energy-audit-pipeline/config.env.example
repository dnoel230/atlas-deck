# Copy to config.env in this same folder (gitignored) to override defaults.
# Nothing here is required — the plugin works with no config.env at all.

# Where the local pipeline database lives. Defaults to
# ~/atlas-data/energy-audit/pipeline.db if unset.
# ATLAS_ENERGY_DB="$HOME/atlas-data/energy-audit/pipeline.db"

# Your own incentive list, once you've customized it beyond the sample.
# Defaults to data/incentives.sample.json if unset.
# ATLAS_ENERGY_INCENTIVES="$HOME/atlas-data/energy-audit/incentives.json"

# Used to sign outreach emails drafted by "Draft outreach email for a lead".
# Leave unset and the drafts use [YOUR BUSINESS NAME] / [YOUR EMAIL] /
# [YOUR PHONE] placeholders instead.
BUSINESS_NAME="Connected Energy"
# CONTACT_EMAIL="you@yourcompany.com"
# CONTACT_PHONE="(555) 555-0100"
