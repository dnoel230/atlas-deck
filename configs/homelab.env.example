# Copy this file to configs/homelab.env and fill in your own values.
# configs/homelab.env is gitignored — never commit real tokens or URLs.

# Home Assistant (used by scripts/energy-dashboard.sh)
HA_URL="http://homeassistant.local:8123"
HA_TOKEN="replace-with-a-long-lived-access-token"

# Optional: comma-separated Home Assistant entity IDs to show on the
# connected energy dashboard. Leave blank to auto-discover sensors whose
# device_class is "power" or "energy".
HA_ENERGY_ENTITIES=""

# Pi-hole
PIHOLE_URL="http://pi.hole/admin"
